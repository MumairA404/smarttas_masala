<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="730.0" prefWidth="1280.0" style="-fx-background-color: #000000;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Text fill="WHITE" layoutX="587.0" layoutY="175.0" text="Login">
            <font><Font name="System Bold" size="40.0" /></font>
        </Text>

        <ImageView fitHeight="178.0" fitWidth="202.0" layoutY="2.0" preserveRatio="true">
            <image><Image url="@../../../img/EVI-logo.png" /></image>
        </ImageView>

        <Text fill="WHITE" layoutX="517.0" layoutY="278.0" text="E-mail">
            <font><Font size="22.0" /></font>
        </Text>

        <Text fill="WHITE" layoutX="517.0" layoutY="408.0" text="Wachtwoord">
            <font><Font size="22.0" /></font>
        </Text>
<!--        <BottomNavigationButton layoutX="103.0" layoutY="25.0" prefHeight="25.0" prefWidth="53.0" style="-fx-background-color: #000000;" text="Home" textFill="WHITE" />-->
<!--        <BottomNavigationButton layoutX="157.0" layoutY="25.0" prefHeight="25.0" prefWidth="111.0" style="-fx-background-color: #000000;" text="klassenoverzicht" textFill="WHITE" />-->
        <Button fx:id="loginButton"
                layoutX="272.0"
                layoutY="311.0"
                mnemonicParsing="false"
                style="-fx-background-color: #2b2b2b; -fx-border-color: #78a0ff; -fx-border-radius: 5px;"
                text="Login"
                textFill="WHITE"
                onAction="#handleLogin"/>
        <TextField fx:id="emailField"
                layoutX="229.0"
                layoutY="172.0"
                style="-fx-border-radius: 5px; -fx-background-color: #2b2b2b; -fx-border-color: #78a0ff;" styleClass="-fx-border-radius" />
        <TextField fx:id="passwordField"
                layoutX="229.0"
                layoutY="253.0"
                style="-fx-border-radius: 5px; -fx-background-color: #2b2b2b; -fx-border-color: #78a0ff;" styleClass="-fx-border-radius" />
      <Button fx:id="homeButton"
              layoutX="128.0"
              layoutY="27.0"
              mnemonicParsing="false"
              style="-fx-text-fill: white; -fx-background-color: #000000;"
              text="Home"
              onAction="#handleHome"/>
      <Button fx:id="klassenButton"
              layoutX="201.0"
              layoutY="27.0"
              mnemonicParsing="false"
              style="-fx-text-fill: white; -fx-background-color: #000000;"
              text="Klassenoverzicht"
              onAction="#handleKlassen"/>
    </children>
</AnchorPane>
