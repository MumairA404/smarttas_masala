<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #000000;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.smarttas.controllers.KlassenoverzichtController">

    <children>
        <Text fill="WHITE" layoutX="472.0" layoutY="169.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Klassen Overzicht" wrappingWidth="352.6">
            <font>
                <Font name="System Bold" size="42.0" />
            </font>
        </Text>

        <ImageView fitHeight="154.0" fitWidth="193.0" layoutX="50.0" layoutY="20.0" preserveRatio="true">
            <image>
                <Image url="@../../../img/EVI-logo.png" />
            </image>
        </ImageView>

        <Button fx:id="homeButton" layoutX="207.0" layoutY="31.0" onAction="#handleHome" prefHeight="32.0" prefWidth="84.0" style="-fx-background-color: #000000;" text="Home" textFill="WHITE">
            <font><Font size="16.0" /></font>
        </Button>

        <Button fx:id="logoutButton" layoutX="1133.0" layoutY="31.0" onAction="#handleLogout" prefHeight="25.0" prefWidth="111.0" style="-fx-background-color: #000000;" text="Uitloggen" textFill="WHITE">
            <font><Font size="16.0" /></font>
        </Button>

        <Button fx:id="klastoevoegenButton" layoutX="672.0" layoutY="198.0" onAction="#handleKlastoevoegen" prefHeight="47.0" prefWidth="202.0" style="-fx-background-color: #000000;" text="VOEG KLAS TOE" textFill="#6fff00">
            <font><Font name="System Bold" size="18.0" /></font>
        </Button>

        <Button fx:id="leerlingtoevoegenButton" layoutX="413.0" layoutY="198.0" onAction="#handleleerlingtoevoegen" prefHeight="47.0" prefWidth="202.0" style="-fx-background-color: #000000;" text="VOEG LEERLING TOE" textFill="#6fff00">
            <font><Font name="System Bold" size="18.0" /></font>
        </Button>

        <!-- Dynamische Klassenlijst -->
        <ScrollPane fx:id="klassenScrollPane"
                    layoutY="350.0"
                    prefWidth="900.0"
                    prefHeight="350.0"
                    fitToWidth="true"
                    style="-fx-background-color: #000000; -fx-background-insets: 0;"
                    AnchorPane.leftAnchor="190.0"
                    AnchorPane.rightAnchor="190.0">
            <content>
                <VBox fx:id="klassenVBox"
                      spacing="15.0"
                      style="-fx-background-color: #000000;"
                      minHeight="0" />
            </content>
        </ScrollPane>

    </children>
</AnchorPane>
